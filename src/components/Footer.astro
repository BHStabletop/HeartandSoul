---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/ui";

interface Props {
  /** Show the breakfast-table banner just above the footer.
   *  Enabled on the homepage only; other pages get the plain mint footer. */
  mood?: boolean;
}

const { mood = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

{mood && (
  <div class="hso-footer-banner" aria-hidden="true">
    <img src="/footer-mood-banner.webp" alt="" loading="lazy" />
  </div>
)}

<footer class:list={["hso-footer", { "hso-footer--mood": mood }]}>
  <div class="hso-footer__inner">
    <img src="/heartandsoul-logo.svg" alt="HEART&SOUL" width="170" height="69" class="hso-footer__logo" />

    <div class="hso-footer__insta">
      <div class="hso-footer__handle">
        <img src="/hso/icons/instagram.svg" alt="" width="24" height="24" />
        <span>{t("footer.instagramHandle")}</span>
      </div>
      <a href="https://www.instagram.com/bhs.tabletop/" target="_blank" rel="noopener noreferrer" class="hso-btn hso-btn--primary">
        {t("footer.instagramCta")}
        <svg width="22" height="10" viewBox="0 0 26 12" fill="none" aria-hidden="true">
          <path d="M1 6h22M18.5 1.5 23.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <nav class="hso-footer__links">
      <a href={`${getLocalizedPath("/", lang)}#contact`} class="hso-footer__link">{t("nav.contact")}</a>
      <a href={getLocalizedPath("/impressum", lang)} class="hso-footer__link">{t("footer.impressum")}</a>
    </nav>

    <p class="hso-footer__copy">&copy;{year} BHS tabletop AG</p>
  </div>
</footer>

<style>
  /* ---------- Blob with a table crop (homepage only) ---------- */
  /* Breakfast-table banner (its organic shape is baked into the image) just
     above the footer, sitting on the green page background. ~50% of the width. */
  .hso-footer-banner {
    position: relative;
    z-index: 1;
    margin-bottom: clamp(-60px, -5vw, -30px);
  }
  .hso-footer-banner img {
    display: block;
    /* Flush to the very left edge, reaching exactly the middle of the screen. */
    width: 50vw;
    height: auto;
  }

  /* ---------- Mint footer (all pages) ---------- */
  .hso-footer {
    position: relative;
    z-index: 2;
    background: var(--hso-green-light);
    border-radius: 42% 58% 0 0 / 15% 22% 0 0;
    padding: clamp(48px, 6vw, 80px) clamp(24px, 6vw, 96px) clamp(28px, 4vw, 44px);
  }
  .hso-footer__inner {
    position: relative;
    z-index: 1;
    width: min(80%, 1100px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    column-gap: clamp(24px, 4vw, 60px);
    row-gap: 0;
  }
  /* Column 1 (logo): right-aligned */
  .hso-footer__logo {
    display: block;
    height: auto;
    width: clamp(110px, 12vw, 160px);
    margin: 0 0 0 auto;
  }
  /* Column 2 (Instagram): centred */
  .hso-footer__insta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .hso-footer__handle {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-core);
    font-weight: var(--fw-core-semi);
    font-size: var(--type-nav-size);
    color: var(--hso-white);
  }
  /* Recolour the instagram glyph to white to match the handle text. */
  .hso-footer__handle img {
    filter: brightness(0) invert(1);
  }
  /* Column 3 (links): left-aligned */
  .hso-footer__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .hso-footer__link {
    font-family: var(--font-core);
    font-weight: var(--fw-core-semi);
    font-size: var(--type-nav-size);
    color: var(--hso-white);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .hso-footer__link:hover {
    opacity: 0.75;
  }
  .hso-footer__copy {
    grid-column: 1 / -1;
    justify-self: center;
    text-align: center;
    margin-top: clamp(20px, 3vw, 36px);
    font-family: var(--font-core);
    font-weight: var(--fw-core-light);
    font-size: var(--type-body-size);
    color: var(--hso-green-deep);
    opacity: 0.75;
  }

  @media (max-width: 599px) {
    .hso-footer__inner {
      width: 90%;
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .hso-footer__logo {
      margin: 0;
    }
    .hso-footer__insta {
      align-items: flex-start;
    }
    .hso-footer__copy {
      justify-self: start;
      margin-top: 0;
    }
  }
</style>
