---
import Blob from "./hso/Blob.astro";
import CollectionCard from "./hso/CollectionCard.astro";
import { collections } from "../data/collections";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const titleCase = (s: string) =>
  s
    .toLowerCase()
    .split(/([\s-])/)
    .map((part) => (/[\s-]/.test(part) ? part : part.charAt(0).toUpperCase() + part.slice(1)))
    .join("");
---

<section class="hso-kollhero">
  <div class="hso-kollhero__image">
    <img src={lang === "de" ? "/collections-hero-de.webp" : "/collections-hero-en.webp"} alt={t("collections.title")} />
  </div>
</section>

<section class="hso-section hso-kollintro">
  <h2>{t("collections.heading")}</h2>
  <p>{t("collections.subtitle")}</p>
</section>

<section class="hso-section hso-kollgrid">
  {collections.map((collection) => (
    <CollectionCard
      name={titleCase(collection.name)}
      image={collection.image}
      href={getLocalizedPath(`/kollektionen/${collection.slug}`, lang)}
      cta={t("collections.cta")}
    />
  ))}
</section>

<style>
  .hso-kollhero {
    position: relative;
    /* Pull up under the transparent sticky header so the image is full-bleed
       to the very top and the logo/menu overlay it (homepage hero style). */
    margin-top: -110px;
    height: min(74vw, 620px);
    min-height: 320px;
    overflow: hidden;
    border-radius: 0 0 62% 42% / 0 0 8% 6%;
  }
  @media (min-width: 900px) {
    .hso-kollhero {
      margin-top: -135px;
    }
  }
  .hso-kollhero__image {
    position: absolute;
    inset: 0;
  }
  .hso-kollhero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hso-kollhero__blob {
    position: absolute;
    left: 50%;
    top: 55%;
    transform: translate(-50%, -50%);
    width: clamp(220px, 30vw, 420px);
  }
  .hso-kollhero__blob :global(.hso-blob) {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 479.686 / 321.459;
  }
  .hso-kollhero__blob h1 {
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.8rem);
    line-height: 1.1;
    color: var(--hso-white);
    margin: 0;
    text-align: center;
  }
  .hso-kollintro {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .hso-kollintro h2 {
    font-size: var(--type-display-size);
    line-height: var(--type-display-lh);
    color: var(--hso-white);
    margin: 0;
    max-width: 780px;
  }
  .hso-kollintro p {
    max-width: 620px;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    font-weight: var(--fw-core-light);
    color: var(--hso-white);
    margin: 0;
  }
  .hso-kollgrid {
    padding-top: clamp(24px, 3vw, 48px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 296px));
    justify-content: center;
    /* Bubble overflow is reserved inside each card, so this row-gap is the true,
       consistent spacing between a button and the bubble of the card below. */
    gap: clamp(40px, 5vw, 64px) 54px;
  }
</style>
