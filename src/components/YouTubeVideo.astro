---
interface Props {
  videoId: string;
  title?: string;
  width?: number | string;
  height?: number | string;
}

const {
  videoId,
  title = "YouTube Video",
  width = "100%",
  height = 400
} = Astro.props;
---

<div class="hso-yt-container" data-video-id={videoId}>
  <div class="hso-yt-placeholder">
    <div class="hso-yt-message">
      <h3>🎬 {title}</h3>
      <p>Dieses Video wird nur angezeigt, wenn du Cookies akzeptiert hast.</p>
      <p class="hso-yt-privacy">
        Durch das Abspielen akzeptierst du die YouTube-Datenschutzerklärung.
      </p>
    </div>
  </div>

  <iframe
    class="hso-yt-iframe"
    width={width}
    height={height}
    src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0`}
    title={title}
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    loading="lazy"
  >
  </iframe>
</div>

<style>
  .hso-yt-container {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .hso-yt-placeholder {
    display: none;
    background: var(--hso-green-deep);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 40px;
    text-align: center;
    color: rgba(255, 255, 255, 0.85);
  }

  .hso-yt-container[data-consent="rejected"] .hso-yt-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
  }

  .hso-yt-message h3 {
    color: var(--hso-white);
    margin: 0 0 16px;
    font-size: 1.25rem;
    font-family: var(--font-core);
  }

  .hso-yt-message p {
    margin: 8px 0;
    font-size: 0.95rem;
  }

  .hso-yt-privacy {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 16px;
  }

  .hso-yt-iframe {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    border: none;
  }

  .hso-yt-container[data-consent="rejected"] .hso-yt-iframe {
    display: none;
  }
</style>

<script>
  function initYouTubeVideos() {
    const videos = document.querySelectorAll('.hso-yt-container');

    function updateVideoConsent() {
      try {
        const consent = localStorage.getItem("cookie-consent");
        videos.forEach(video => {
          if (consent === "accepted") {
            video.removeAttribute("data-consent");
          } else {
            video.setAttribute("data-consent", "rejected");
          }
        });
      } catch (e) {}
    }

    // Update on load
    updateVideoConsent();

    // Update when consent changes
    window.addEventListener("cookie-consent-updated", updateVideoConsent);
  }

  initYouTubeVideos();
</script>
