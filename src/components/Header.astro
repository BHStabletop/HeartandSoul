---
const links = [
  { href: "#about", label: "Über uns" },
  { href: "#values", label: "Werte" },
  { href: "#contact", label: "Kontakt" },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-900/80 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="#" class="text-lg font-bold tracking-tight text-white">
      HEART<span class="text-brand-400">&</span>SOUL
    </a>
    <ul class="hidden gap-8 text-sm font-medium text-white/70 sm:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition hover:text-white">{link.label}</a>
        </li>
      ))}
    </ul>
    <a
      href="#contact"
      class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-500"
    >
      Kontakt aufnehmen
    </a>
  </nav>
</header>
