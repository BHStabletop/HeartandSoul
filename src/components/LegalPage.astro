---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="hso-section hso-legal">
  <p class="hso-legal__eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <div class="legal-content">
    <slot />
  </div>
</section>

<style>
  .hso-legal {
    max-width: 780px;
    margin-inline: auto;
  }
  .hso-legal__eyebrow {
    font-family: var(--font-core);
    font-weight: var(--fw-core-semi);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--hso-green-light);
    margin: 0;
  }
  .hso-legal h1 {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.75rem);
    line-height: 1.15;
    color: var(--hso-white);
    margin: 16px 0 0;
  }
  .legal-content {
    margin-top: 40px;
    color: var(--hso-white);
    font-family: var(--font-core);
    font-weight: var(--fw-core-light);
  }
  .legal-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-family: var(--font-core);
    font-weight: var(--fw-core-semi);
    color: white;
  }
  .legal-content :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-content :global(p) {
    margin-top: 0.75rem;
    line-height: 1.7;
  }
  .legal-content :global(ul) {
    margin-top: 0.75rem;
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal-content :global(li) {
    margin-top: 0.35rem;
    line-height: 1.7;
  }
  .legal-content :global(a) {
    color: white;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content :global(strong) {
    color: white;
  }
</style>
