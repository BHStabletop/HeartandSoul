---
import Button from "./hso/Button.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="hso-section hso-contact">
  <h2>{t("contact.title")}</h2>
  <p>{t("contact.subtitle")}</p>
  <Button href="https://www.bhs-tabletop.com/de-de/kontakt/#/" target="_blank" rel="noopener noreferrer" minWidth={240}>{t("contact.cta")}</Button>
</section>

<style>
  .hso-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }
  .hso-contact h2 {
    font-size: var(--type-display-size);
    line-height: var(--type-display-lh);
    color: var(--hso-white);
    margin: 0;
  }
  .hso-contact p {
    max-width: 500px;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    font-weight: var(--fw-core-light);
    color: var(--hso-white);
    margin: 0;
  }
</style>
