---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hso-hero">
  <div class="hso-hero__image">
    <img src="/home-hero.webp" alt={t("hero.imageAlt")} fetchpriority="high" />
  </div>
  <!-- Headline is baked into the background artwork; keep an accessible heading. -->
  <h1 class="hso-hero__sr">Love at first sight</h1>
  <a href="#about" class="hso-hero__scroll" aria-label={t("hero.scrollCue")}>
    <svg width="18" height="34" viewBox="0 0 18 34" fill="none" aria-hidden="true">
      <path d="M9 0v33M1 25l8 8 8-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</section>

<style>
  .hso-hero {
    position: relative;
    /* Pull up under the (transparent) sticky header so the image is full-bleed
       to the very top and the logo/menu overlay it, as in the mockup. */
    margin-top: -110px;
    height: min(84vw, 820px);
    min-height: 340px;
    overflow: hidden;
    border-radius: 0 0 62% 42% / 0 0 8% 6%;
  }
  @media (min-width: 900px) {
    .hso-hero {
      margin-top: -135px;
    }
  }
  .hso-hero__image {
    position: absolute;
    inset: 0;
  }
  .hso-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    display: block;
  }
  /* Visually hidden but available to screen readers / SEO. */
  .hso-hero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .hso-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(16px, 4vw, 40px);
    transform: translateX(-50%);
    color: var(--hso-white);
    opacity: 0.85;
    transition: opacity var(--dur-fast) var(--ease-soft);
  }
  .hso-hero__scroll:hover {
    opacity: 1;
  }
</style>
