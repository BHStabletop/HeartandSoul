---
import PropertyBadge from "./hso/PropertyBadge.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const PROPERTIES = [
  { icon: "dishwasher", key: "dishwasher" },
  { icon: "microwave", key: "microwave" },
  { icon: "oven", key: "oven" },
  { icon: "stackable", key: "stackable" },
  { icon: "unique", key: "unique" },
  { icon: "colour-variance", key: "colourVariance" },
  { icon: "in-stock", key: "inStock" },
  { icon: "fair-produced", key: "fairProduced" },
] as const;
---

<section id="values" class="hso-section hso-values">
  <h2>{t("values.heading")}</h2>
  <p class="hso-values__intro">{t("values.intro")}</p>
  <div class="hso-values__grid">
    {PROPERTIES.map((p) => (
      <PropertyBadge icon={p.icon} label={t(`values.${p.key}` as any)} />
    ))}
  </div>
</section>

<style>
  .hso-values {
    text-align: center;
  }
  .hso-values h2 {
    font-size: var(--type-display-size);
    line-height: var(--type-display-lh);
    color: var(--hso-white);
    margin: 0 0 24px;
  }
  .hso-values__intro {
    max-width: 620px;
    margin: 0 auto clamp(40px, 6vw, 80px);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    font-weight: var(--fw-core-light);
    color: var(--hso-white);
  }
  .hso-values__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 24px;
    justify-items: center;
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .hso-values__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
