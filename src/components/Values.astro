---
const values = [
  {
    title: "Herz",
    description: "Wir arbeiten mit echtem Engagement — nicht nur nach Vorschrift.",
  },
  {
    title: "Sorgfalt",
    description: "Details entscheiden. Wir nehmen uns die Zeit, sie richtig zu machen.",
  },
  {
    title: "Ehrlichkeit",
    description: "Klare Kommunikation und Verlässlichkeit sind für uns Grundlage jeder Zusammenarbeit.",
  },
];
---

<section id="values" class="border-t border-white/10 bg-ink-800 px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <p class="text-center text-sm font-semibold uppercase tracking-[0.2em] text-brand-400">
      Werte
    </p>
    <h2 class="mt-4 text-center text-3xl font-bold text-white sm:text-4xl">
      Was uns antreibt
    </h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      {values.map((value) => (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-8">
          <h3 class="text-xl font-semibold text-white">{value.title}</h3>
          <p class="mt-3 text-white/70">{value.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
