---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "tertiary";
  minWidth?: number;
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = "tertiary", minWidth, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const style = minWidth ? { minWidth: `${minWidth}px` } : undefined;
const variantClass = variant === "secondary" ? "hso-btn--secondary" : variant === "primary" ? "hso-btn--primary" : "hso-btn--tertiary";
---

<Tag href={href} class:list={["hso-btn", variantClass, className]} style={style} {...rest}>
  <slot />
  <svg width="22" height="10" viewBox="0 0 26 12" fill="none" aria-hidden="true">
    <path d="M1 6h22M18.5 1.5 23.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</Tag>
