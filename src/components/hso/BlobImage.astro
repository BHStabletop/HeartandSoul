---
import { getBlob, type BlobShape } from "./blobs";

interface Props {
  src: string;
  alt?: string;
  shape?: BlobShape;
  width?: number | string;
  height?: number | string;
  rotate?: number;
  objectPosition?: string;
  class?: string;
}

const {
  src,
  alt = "",
  shape = "medium",
  width = 433,
  height,
  rotate = 0,
  objectPosition = "center",
  class: className,
} = Astro.props;

const s = getBlob(shape);
const w = Number(width) || 433;
const h = height != null ? Number(height) : (w / s.vw) * s.vh;
const rad = (Math.abs(rotate) * Math.PI) / 180;
const c = Math.cos(rad);
const sn = Math.sin(rad);
const cover = rotate ? Math.max(c + sn * (h / w), c + sn * (w / h)) * 1.02 : 1;
const id = `hso-blobimg-${shape}-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={["hso-blobimage", className]} style={{ position: "relative", width: `${w}px`, height: `${h}px`, transform: rotate ? `rotate(${rotate}deg)` : undefined, maxWidth: "100%" }}>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
    <defs>
      <clipPath id={id} clipPathUnits="objectBoundingBox"><path d={s.nd} /></clipPath>
    </defs>
  </svg>
  <div style={{ position: "absolute", inset: 0, background: "var(--surface-blob)", clipPath: `url(#${id})`, WebkitClipPath: `url(#${id})`, overflow: "hidden" }}>
    <img
      src={src}
      alt={alt}
      style={{ width: "100%", height: "100%", objectFit: "cover", objectPosition, display: "block", transform: rotate ? `rotate(${-rotate}deg) scale(${cover.toFixed(4)})` : undefined }}
      loading="lazy"
    />
  </div>
</div>
