---
interface Props {
  icon: string;
  label: string;
}

const { icon, label } = Astro.props;
---

<div class="hso-badge">
  <img src={`/hso/icons/${icon}.svg`} alt="" width="90" height="90" loading="lazy" />
  <span>{label}</span>
</div>

<style>
  .hso-badge {
    width: 100%;
    max-width: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .hso-badge img {
    width: clamp(64px, 8vw, 90px);
    height: auto;
  }
  .hso-badge span {
    font-family: var(--font-core);
    font-weight: var(--fw-core-semi);
    font-size: var(--type-badge-size);
    line-height: 1.3;
    color: var(--hso-white);
    white-space: pre-line;
  }
</style>
