---
interface Props {
  /** 1-based catalogue page to open to. */
  startPage?: number;
}
const { startPage = 1 } = Astro.props;

const PAGES = 148;
const images = Array.from(
  { length: PAGES },
  (_, i) => `/catalog/page-${String(i + 1).padStart(3, "0")}.webp`,
);
---

<section class="hso-section hso-catalog" data-start={startPage}>
  <h2>Katalog</h2>

  <div class="hso-catalog__stage">
    <button type="button" class="hso-catalog__nav hso-catalog__nav--prev" aria-label="Zurückblättern">
      <svg width="16" height="28" viewBox="0 0 16 28" fill="none" aria-hidden="true"><path d="M14 2 3 14l11 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="hso-catalog__viewport">
      <div class="hso-catalog__book" id="hso-flipbook"></div>
      <div class="hso-catalog__placeholder" aria-hidden="true">
        <img src="/catalog/page-001.webp" alt="" loading="lazy" />
        <span class="hso-catalog__cue">Zum Blättern tippen</span>
      </div>
    </div>

    <button type="button" class="hso-catalog__nav hso-catalog__nav--next" aria-label="Weiterblättern">
      <svg width="16" height="28" viewBox="0 0 16 28" fill="none" aria-hidden="true"><path d="M2 2l11 12L2 26" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="hso-catalog__bar">
    <p class="hso-catalog__counter">Seite <span data-cur>–</span> / {PAGES}</p>
    <button type="button" class="hso-catalog__zoom" aria-label="Seite vergrößern">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
        <path d="M21 21l-4.3-4.3M11 8v6M8 11h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>Vergrößern</span>
    </button>
  </div>

  <script type="application/json" class="hso-catalog__data" set:html={JSON.stringify(images)} is:inline></script>
</section>

<div class="hso-catalog-lightbox" id="hso-catalog-lightbox" hidden>
  <button type="button" class="hso-catalog-lightbox__close" aria-label="Schließen">&times;</button>
  <div class="hso-catalog-lightbox__stage"></div>
</div>

<script>
  const PF_SRC = "https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js";

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) return resolve();
      const s = document.createElement("script");
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error("load failed"));
      document.head.appendChild(s);
    });
  }

  document.querySelectorAll<HTMLElement>(".hso-catalog").forEach((section) => {
    const el = section.querySelector<HTMLElement>(".hso-catalog__book")!;
    const images: string[] = JSON.parse(section.querySelector(".hso-catalog__data")!.textContent || "[]");
    const startPage = Number(section.dataset.start || 1);
    const curEl = section.querySelector<HTMLElement>("[data-cur]");
    let pf: any = null;
    let inited = false;

    const setCounter = () => {
      if (curEl && pf) curEl.textContent = String(pf.getCurrentPageIndex() + 1);
    };

    async function init() {
      if (inited) return;
      inited = true;
      try {
        await loadScript(PF_SRC);
      } catch {
        section.classList.add("is-error");
        return;
      }
      const St = (window as any).St;
      pf = new St.PageFlip(el, {
        width: 450,
        height: 636,
        size: "stretch",
        minWidth: 180,
        maxWidth: 720,
        minHeight: 254,
        maxHeight: 1018,
        showCover: true,
        usePortrait: true,
        mobileScrollSupport: true,
        maxShadowOpacity: 0.4,
        flippingTime: 700,
      });
      pf.on("init", () => {
        section.classList.add("is-ready");
        if (startPage > 1) pf.turnToPage(startPage - 1);
        setCounter();
      });
      pf.on("flip", setCounter);
      pf.loadFromImages(images);

      section.querySelector(".hso-catalog__nav--prev")?.addEventListener("click", () => pf?.flipPrev());
      section.querySelector(".hso-catalog__nav--next")?.addEventListener("click", () => pf?.flipNext());
    }

    // --- Zoom lightbox: show the current spread in high resolution ---
    const lightbox = document.getElementById("hso-catalog-lightbox")!;
    const stage = lightbox.querySelector<HTMLElement>(".hso-catalog-lightbox__stage")!;
    const zoomSrc = (n: number) => `/catalog/zoom/page-${String(n).padStart(3, "0")}.webp`;

    const openZoom = () => {
      if (!pf) return;
      const idx = pf.getCurrentPageIndex(); // 0-based
      let pages: number[];
      if (idx <= 0) pages = [1];
      else {
        const left = idx % 2 === 1 ? idx : idx - 1; // spreads are (1,2),(3,4)…
        pages = [left + 1, left + 2].filter((p) => p >= 1 && p <= images.length);
      }
      stage.innerHTML = "";
      for (const p of pages) {
        const img = document.createElement("img");
        img.src = zoomSrc(p);
        img.alt = `Katalog Seite ${p}`;
        img.className = "hso-catalog-lightbox__page";
        img.addEventListener("click", () => img.classList.toggle("is-zoomed"));
        stage.appendChild(img);
      }
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
    };

    const closeZoom = () => {
      lightbox.hidden = true;
      stage.innerHTML = "";
      document.body.style.overflow = "";
    };

    section.querySelector(".hso-catalog__zoom")?.addEventListener("click", openZoom);
    lightbox.querySelector(".hso-catalog-lightbox__close")?.addEventListener("click", closeZoom);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === stage) closeZoom();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !lightbox.hidden) closeZoom();
    });

    // Only build the flipbook (loads the page images) once it scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          init();
        }
      },
      { rootMargin: "300px" },
    );
    io.observe(section);
  });
</script>

<style>
  .hso-catalog {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(22px, 4vw, 38px);
  }
  .hso-catalog > h2 {
    font-size: var(--type-display-size);
    line-height: var(--type-display-lh);
    color: var(--hso-white);
    margin: 0;
    text-align: center;
  }
  .hso-catalog__stage {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(6px, 2vw, 16px);
  }
  .hso-catalog__viewport {
    position: relative;
    flex: 1;
    max-width: 1000px;
    aspect-ratio: 1424 / 1006; /* two pages side by side */
  }
  @media (max-width: 720px) {
    .hso-catalog__viewport {
      aspect-ratio: 712 / 1006; /* single page on small screens */
      max-width: 460px;
    }
  }
  .hso-catalog__book {
    width: 100%;
    height: 100%;
  }
  .hso-catalog__book :global(img) {
    width: 100%;
    height: 100%;
  }
  /* Cover placeholder shown until the flipbook is initialised. */
  .hso-catalog__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .hso-catalog__placeholder img {
    max-height: 100%;
    width: auto;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }
  .hso-catalog__cue {
    position: absolute;
    bottom: 14px;
    font-size: 0.85rem;
    color: var(--hso-white);
    background: rgba(0, 0, 0, 0.35);
    padding: 4px 12px;
    border-radius: 999px;
  }
  .hso-catalog.is-ready .hso-catalog__placeholder {
    display: none;
  }
  .hso-catalog__nav {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--hso-white);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity var(--dur-fast) var(--ease-soft);
  }
  .hso-catalog__nav:hover {
    opacity: 1;
  }
  .hso-catalog__bar {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 32px);
  }
  .hso-catalog__counter {
    margin: 0;
    font-size: var(--type-body-size);
    color: var(--hso-white);
    opacity: 0.8;
  }
  .hso-catalog__zoom {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: none;
    color: var(--hso-white);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-soft);
  }
  .hso-catalog__zoom:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  /* ---------- Zoom lightbox ---------- */
  .hso-catalog-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.92);
    overflow: auto;
    overscroll-behavior: contain;
    padding: clamp(16px, 4vw, 48px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .hso-catalog-lightbox[hidden] {
    display: none;
  }
  .hso-catalog-lightbox__stage {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(10px, 2vw, 24px);
    margin: auto;
  }
  .hso-catalog-lightbox__page {
    width: min(760px, 92vw);
    height: auto;
    border-radius: 3px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    cursor: zoom-in;
  }
  /* Click a page to view it at full resolution (scroll to pan). */
  .hso-catalog-lightbox__page.is-zoomed {
    width: 1370px;
    max-width: none;
    cursor: zoom-out;
  }
  .hso-catalog-lightbox__close {
    position: fixed;
    top: clamp(10px, 2vw, 22px);
    right: clamp(10px, 2vw, 22px);
    z-index: 101;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: var(--hso-white);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
  .hso-catalog-lightbox__close:hover {
    background: rgba(0, 0, 0, 0.75);
  }
</style>
