---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="instagram" class="border-t border-white/10 bg-ink-800 px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <p class="text-center text-sm font-semibold uppercase tracking-[0.2em] text-brand-400">
      {t("instagram.eyebrow")}
    </p>
    <h2 class="mt-4 text-center text-3xl font-bold text-white sm:text-4xl">{t("instagram.title")}</h2>
    <p class="mx-auto mt-4 max-w-xl text-center text-white/70">{t("instagram.subtitle")}</p>

    <div
      id="instagram-feed"
      data-loading={t("instagram.loading")}
      data-empty={t("instagram.empty")}
      data-error={t("instagram.error")}
      class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
    >
      <p class="col-span-full text-center text-sm text-white/50">{t("instagram.loading")}</p>
    </div>

    <div class="mt-10 text-center">
      <a
        href="https://www.instagram.com/bhs.tabletop/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-brand-400 transition hover:text-brand-300"
      >
        {t("instagram.cta")} &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  interface InstagramPost {
    id: string;
    caption: string;
    mediaUrl: string;
    permalink: string;
  }

  async function loadInstagramFeed() {
    const container = document.getElementById("instagram-feed");
    if (!container) return;

    const showMessage = (text: string) => {
      container.replaceChildren();
      const p = document.createElement("p");
      p.className = "col-span-full text-center text-sm text-white/50";
      p.textContent = text;
      container.appendChild(p);
    };

    try {
      const res = await fetch("/api/instagram");
      if (!res.ok) throw new Error(`request failed with ${res.status}`);

      const data: { posts: InstagramPost[] } = await res.json();
      const posts = data.posts ?? [];

      if (!posts.length) {
        showMessage(container.dataset.empty ?? "");
        return;
      }

      container.replaceChildren();
      for (const post of posts) {
        const link = document.createElement("a");
        link.href = post.permalink;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className =
          "group block aspect-square overflow-hidden rounded-2xl border border-white/10 bg-white/5";

        const img = document.createElement("img");
        img.src = post.mediaUrl;
        img.alt = post.caption ? post.caption.slice(0, 140) : "";
        img.loading = "lazy";
        img.className = "h-full w-full object-cover transition duration-300 group-hover:scale-105";

        link.appendChild(img);
        container.appendChild(link);
      }
    } catch {
      showMessage(container.dataset.error ?? "");
    }
  }

  loadInstagramFeed();
</script>
