---
import Blob from "./hso/Blob.astro";
import Button from "./hso/Button.astro";
import { collections } from "../data/collections";
import { getLangFromUrl, useTranslations } from "../i18n/ui";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const collection = collections.find((c) => c.slug === slug);
if (!collection) throw new Error(`Unknown collection slug: ${slug}`);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const name = collection.name
  .toLowerCase()
  .replace(/(^|[\s-])([a-z])/g, (_, sep, ch) => sep + ch.toUpperCase());
const description = lang === "de" ? collection.descriptionDe : collection.descriptionEn;
const shopUrl = lang === "de" ? collection.urlDe : collection.urlEn;

const detail = collection.detail;
const heading = detail ? (lang === "de" ? detail.headingDe : detail.headingEn) : undefined;
const body = detail ? (lang === "de" ? detail.bodyDe : detail.bodyEn) : description;
const articles = detail?.articles ?? [];
const moods = detail?.moods ?? [];
const isMulti = articles.length > 1;
---

{detail ? (
  <section class="hso-cd-hero">
    <div class="hso-cd-hero__image">
      <img src={detail.header} alt={`${name} — HEART&SOUL`} fetchpriority="high" />
    </div>
    <a href="#intro" class="hso-cd-hero__scroll" aria-label={t("hero.scrollCue")}>
      <svg width="18" height="34" viewBox="0 0 18 34" fill="none" aria-hidden="true">
        <path d="M9 0v33M1 25l8 8 8-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>
) : (
  <section class="hso-cd-herofallback">
    <div class="hso-cd-herofallback__blob">
      <Blob shape="bubble" width={260} color="var(--hso-white)">
        <span>{name}</span>
      </Blob>
    </div>
    <img src={collection.image} alt={name} />
  </section>
)}

<section id="intro" class="hso-section hso-cd-intro">
  {heading ? <h1>{heading}</h1> : <h1 class="hso-cd-intro__sr">{name}</h1>}
  <p>{body}</p>
</section>

{detail && articles.length > 0 && (
  <section class="hso-section hso-cd-articles">
    <h2>{t("collectionDetail.setHeading")}</h2>

    {isMulti ? (
      <div class="hso-artslider" data-artslider>
        <div class="hso-artslider__viewport">
          <button type="button" class="hso-artslider__nav hso-artslider__nav--prev" aria-label="◀" data-dir="-1">
            <svg width="16" height="28" viewBox="0 0 16 28" fill="none" aria-hidden="true"><path d="M14 2 3 14l11 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="hso-artslider__track">
            {articles.map((a, i) => (
              <div class="hso-artslider__slide" data-color={a.color ?? ""}>
                <img src={a.image} alt={`${name} ${a.color ?? ""}`.trim()} loading={i === 0 ? "eager" : "lazy"} />
              </div>
            ))}
          </div>
          <button type="button" class="hso-artslider__nav hso-artslider__nav--next" aria-label="▶" data-dir="1">
            <svg width="16" height="28" viewBox="0 0 16 28" fill="none" aria-hidden="true"><path d="M2 2l11 12L2 26" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <p class="hso-artslider__label"><span class="hso-artslider__labelcaption">{t("collectionDetail.colorLabel")}:</span> <span data-artlabel>{articles[0].color}</span></p>
        <div class="hso-artslider__dots" role="tablist">
          {articles.map((a, i) => (
            <button type="button" class="hso-artslider__dot" data-index={i} aria-label={a.color ?? `${i + 1}`}></button>
          ))}
        </div>
      </div>
    ) : (
      <div class="hso-cd-articles__single">
        <img src={articles[0].image} alt={`${name} ${t("collectionDetail.setHeading")}`} loading="lazy" />
      </div>
    )}

    <Button href={shopUrl} minWidth={230} target="_blank" rel="noopener noreferrer">
      {t("collectionDetail.productCta")}
    </Button>
  </section>
)}

{detail && moods.length > 0 && (
  <section class="hso-section hso-cd-mood">
    <h2>{t("collectionDetail.moodHeading")}</h2>
    <div class="hso-cd-carousel" aria-roledescription="carousel">
      <button type="button" class="hso-cd-carousel__nav hso-cd-carousel__nav--prev" aria-label="◀" data-dir="-1" hidden={moods.length < 2}>
        <svg width="16" height="28" viewBox="0 0 16 28" fill="none" aria-hidden="true"><path d="M14 2 3 14l11 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="hso-cd-carousel__track">
        {moods.map((src, i) => (
          <div class="hso-cd-carousel__slide">
            <img src={src} alt="" loading="lazy" aria-label={`${i + 1} / ${moods.length}`} />
          </div>
        ))}
      </div>
      <button type="button" class="hso-cd-carousel__nav hso-cd-carousel__nav--next" aria-label="▶" data-dir="1" hidden={moods.length < 2}>
        <svg width="16" height="28" viewBox="0 0 16 28" fill="none" aria-hidden="true"><path d="M2 2l11 12L2 26" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </section>
)}

<script>
  // --- Mood carousel: scroll one viewport per click ---
  document.querySelectorAll<HTMLElement>(".hso-cd-carousel").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>(".hso-cd-carousel__track");
    if (!track) return;
    carousel.querySelectorAll<HTMLButtonElement>(".hso-cd-carousel__nav").forEach((btn) => {
      btn.addEventListener("click", () => {
        const dir = Number(btn.dataset.dir);
        track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });
      });
    });
  });

  // --- Article colour slider: nav + dots + live colour label ---
  document.querySelectorAll<HTMLElement>("[data-artslider]").forEach((slider) => {
    const track = slider.querySelector<HTMLElement>(".hso-artslider__track");
    const label = slider.querySelector<HTMLElement>("[data-artlabel]");
    const slides = Array.from(slider.querySelectorAll<HTMLElement>(".hso-artslider__slide"));
    const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>(".hso-artslider__dot"));
    if (!track || slides.length === 0) return;

    const indexFromScroll = () => Math.round(track.scrollLeft / track.clientWidth);
    const setActive = (i: number) => {
      const color = slides[i]?.dataset.color ?? "";
      if (label) label.textContent = color;
      dots.forEach((d, di) => d.setAttribute("aria-selected", String(di === i)));
    };

    const goTo = (i: number) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: clamped * track.clientWidth, behavior: "smooth" });
    };

    slider.querySelectorAll<HTMLButtonElement>(".hso-artslider__nav").forEach((btn) => {
      btn.addEventListener("click", () => goTo(indexFromScroll() + Number(btn.dataset.dir)));
    });
    dots.forEach((dot) => dot.addEventListener("click", () => goTo(Number(dot.dataset.index))));

    let raf = 0;
    track.addEventListener("scroll", () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => setActive(indexFromScroll()));
    });
    setActive(0);
  });
</script>

<style>
  /* ---------- Hero (full-bleed banner, same style as the homepage) ---------- */
  .hso-cd-hero {
    position: relative;
    /* Pull up under the transparent sticky header so the image is full-bleed
       to the very top and the logo/menu overlay it (homepage hero style). */
    margin-top: -110px;
    height: min(84vw, 820px);
    min-height: 340px;
    overflow: hidden;
    border-radius: 0 0 62% 42% / 0 0 8% 6%;
  }
  @media (min-width: 900px) {
    .hso-cd-hero {
      margin-top: -135px;
    }
  }
  .hso-cd-hero__image {
    position: absolute;
    inset: 0;
  }
  .hso-cd-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    display: block;
  }
  .hso-cd-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(16px, 4vw, 40px);
    transform: translateX(-50%);
    color: var(--hso-white);
    opacity: 0.85;
    transition: opacity var(--dur-fast) var(--ease-soft);
  }
  .hso-cd-hero__scroll:hover {
    opacity: 1;
  }

  /* ---------- Fallback hero ---------- */
  .hso-cd-herofallback {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(40px, 8vw, 90px) 20px 20px;
  }
  .hso-cd-herofallback__blob {
    position: absolute;
    top: clamp(20px, 5vw, 60px);
    z-index: 1;
    width: clamp(180px, 26vw, 260px);
  }
  .hso-cd-herofallback__blob :global(.hso-blob) {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 220 / 207;
  }
  .hso-cd-herofallback__blob span {
    font-family: var(--font-display);
    font-weight: var(--fw-display-bold);
    font-size: var(--type-collection-size);
    line-height: var(--type-collection-lh);
    color: var(--text-on-light);
  }
  .hso-cd-herofallback img {
    width: min(360px, 80%);
    height: auto;
    margin-top: 60px;
  }

  /* ---------- Intro ---------- */
  .hso-cd-intro {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .hso-cd-intro h1 {
    font-size: var(--type-display-size);
    line-height: var(--type-display-lh);
    color: var(--hso-white);
    margin: 0;
    max-width: 780px;
  }
  /* Visually hidden heading (keeps one H1 for a11y when no custom heading) */
  .hso-cd-intro__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .hso-cd-intro p {
    max-width: 620px;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    font-weight: var(--fw-core-light);
    color: var(--hso-white);
    margin: 0;
  }

  /* ---------- Section headings (article + mood) ---------- */
  .hso-cd-articles,
  .hso-cd-mood {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 4vw, 40px);
  }
  .hso-cd-articles > h2,
  .hso-cd-mood > h2 {
    font-size: var(--type-display-size);
    line-height: var(--type-display-lh);
    color: var(--hso-white);
    margin: 0;
    text-align: center;
  }

  /* ---------- Article preview (single) ---------- */
  .hso-cd-articles__single {
    width: 100%;
    display: grid;
    place-items: center;
  }
  .hso-cd-articles__single img {
    width: min(760px, 100%);
    height: auto;
    display: block;
  }

  /* ---------- Article colour slider ---------- */
  .hso-artslider {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .hso-artslider__viewport {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hso-artslider__track {
    flex: 1;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hso-artslider__track::-webkit-scrollbar {
    display: none;
  }
  .hso-artslider__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: grid;
    place-items: center;
  }
  .hso-artslider__slide img {
    width: min(760px, 100%);
    height: auto;
    display: block;
  }
  .hso-artslider__nav,
  .hso-cd-carousel__nav {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--hso-white);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity var(--dur-fast) var(--ease-soft);
  }
  .hso-artslider__nav:hover,
  .hso-cd-carousel__nav:hover {
    opacity: 1;
  }
  .hso-artslider__label {
    margin: 0;
    font-size: var(--type-body-size);
    color: var(--hso-white);
    letter-spacing: 0.02em;
  }
  .hso-artslider__labelcaption {
    opacity: 0.7;
  }
  .hso-artslider__dots {
    display: flex;
    gap: 10px;
  }
  .hso-artslider__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1.5px solid var(--hso-white);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease-soft), background var(--dur-fast) var(--ease-soft);
  }
  .hso-artslider__dot:hover {
    opacity: 1;
  }
  .hso-artslider__dot[aria-selected="true"] {
    background: var(--hso-white);
    opacity: 1;
  }

  /* ---------- Mood carousel ---------- */
  .hso-cd-carousel {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding-left: clamp(16px, 5vw, 80px);
    padding-right: clamp(16px, 5vw, 80px);
  }
  .hso-cd-carousel__track {
    flex: 1;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 24px;
  }
  .hso-cd-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .hso-cd-carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: grid;
    place-items: center;
  }
  .hso-cd-carousel__slide img {
    width: min(900px, 100%);
    height: auto;
    display: block;
  }
  .hso-cd-carousel__nav[hidden] {
    display: none;
  }
</style>
