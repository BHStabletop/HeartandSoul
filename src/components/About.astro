---
import Button from "./hso/Button.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="hso-section hso-about">
  <h2>{t("about.heading")}</h2>
  <p>{t("about.body")}</p>
  <Button href="#values" minWidth={220}>{t("about.cta")}</Button>
</section>

<style>
  .hso-about {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 30px;
  }
  .hso-about h2 {
    font-size: var(--type-display-size);
    line-height: var(--type-display-lh);
    color: var(--hso-white);
    margin: 0;
    max-width: 780px;
  }
  .hso-about p {
    max-width: 620px;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    font-weight: var(--fw-core-light);
    color: var(--hso-white);
    margin: 0;
  }
</style>
