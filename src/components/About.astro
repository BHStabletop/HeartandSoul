---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="border-t border-white/10 px-6 py-24">
  <div class="mx-auto grid max-w-6xl gap-12 sm:grid-cols-2 sm:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-400">{t("about.eyebrow")}</p>
      <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
        {t("about.title")}
      </h2>
    </div>
    <div class="space-y-4 text-white/70">
      <p>{t("about.p1")}</p>
      <p>{t("about.p2")}</p>
    </div>
  </div>
</section>
