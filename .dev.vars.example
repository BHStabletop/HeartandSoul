# Copy to .dev.vars for local testing with `npx wrangler pages dev dist`.
# In production, set these as encrypted secrets in Cloudflare Pages instead
# (Dashboard -> your project -> Settings -> Environment variables, or via
# `npx wrangler pages secret put <NAME> --project-name=<project>`).

# Long-lived access token of YOUR OWN Instagram Business/Creator account,
# generated via the Meta Graph API Explorer / a Meta app with the
# instagram_basic and pages_show_list permissions.
IG_ACCESS_TOKEN=

# The Instagram Business Account ID behind that same access token
# (used to query Business Discovery on @bhs.tabletop).
IG_BUSINESS_ID=

# Optional overrides (defaults shown):
# IG_TARGET_USERNAME=bhs.tabletop
# IG_HASHTAG=MyHeartAndSoulMoment
